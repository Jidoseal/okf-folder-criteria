{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jidoseal/okf-folder-criteria/blob/v1.0.0/schema/okf-folder-criteria-1.0.schema.json",
  "title": "OKF Folder Criteria v1.0.0: one document's parsed frontmatter",
  "description": "Root schema = Bronze, the grade conformity needs. Apply to parsed YAML frontmatter, with dates written as strings. Covers English keys only; see data/key-aliases.json for native-language keys under F2 to F5 and G1. A schema cannot test O1 (strict parse), O3 (index.md and log.md), that a V2 path exists, the date order in V3 and V4, or SPDX ids in V5. CRITERIA.md is the rule; this file is a partial aid. This is not an OKF validator; see CRITERIA.md section 7.",
  "$defs": {
    "populated": {
      "not": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "pattern": "^\\s*$"
          },
          {
            "type": "array",
            "maxItems": 0
          },
          {
            "type": "object",
            "maxProperties": 0
          }
        ]
      }
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[0-9:.]+(Z|[+-]\\d{2}:\\d{2}))?$",
      "$comment": "Form only. V3 and V4 also need a real calendar date, not after the scan date; a schema cannot test that."
    },
    "okfCertified": {
      "title": "OKF Certified: O2 (O1 and O3 cannot be tested by a schema on parsed frontmatter)",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/populated"
        }
      }
    },
    "bronze": {
      "title": "Bronze: OKF Certified + F1 to F5",
      "allOf": [
        {
          "$ref": "#/$defs/okfCertified"
        },
        {
          "$comment": "F2",
          "allOf": [
            {
              "required": [
                "title"
              ],
              "properties": {
                "title": {
                  "$ref": "#/$defs/populated"
                }
              }
            }
          ]
        },
        {
          "$comment": "F3",
          "anyOf": [
            {
              "required": [
                "description"
              ],
              "properties": {
                "description": {
                  "$ref": "#/$defs/populated"
                }
              }
            },
            {
              "required": [
                "desc"
              ],
              "properties": {
                "desc": {
                  "$ref": "#/$defs/populated"
                }
              }
            }
          ]
        },
        {
          "$comment": "F4",
          "anyOf": [
            {
              "required": [
                "timestamp"
              ],
              "properties": {
                "timestamp": {
                  "$ref": "#/$defs/populated"
                }
              }
            },
            {
              "required": [
                "updated"
              ],
              "properties": {
                "updated": {
                  "$ref": "#/$defs/populated"
                }
              }
            },
            {
              "required": [
                "created"
              ],
              "properties": {
                "created": {
                  "$ref": "#/$defs/populated"
                }
              }
            },
            {
              "required": [
                "date"
              ],
              "properties": {
                "date": {
                  "$ref": "#/$defs/populated"
                }
              }
            },
            {
              "required": [
                "generated"
              ],
              "properties": {
                "generated": {
                  "type": "object",
                  "required": [
                    "at"
                  ],
                  "properties": {
                    "at": {
                      "$ref": "#/$defs/populated"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "$comment": "F5",
          "anyOf": [
            {
              "required": [
                "owner"
              ],
              "properties": {
                "owner": {
                  "$ref": "#/$defs/populated"
                }
              }
            },
            {
              "required": [
                "author"
              ],
              "properties": {
                "author": {
                  "$ref": "#/$defs/populated"
                }
              }
            },
            {
              "required": [
                "generated"
              ],
              "properties": {
                "generated": {
                  "type": "object",
                  "required": [
                    "by"
                  ],
                  "properties": {
                    "by": {
                      "$ref": "#/$defs/populated"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "silver": {
      "title": "Silver: Bronze + G1 to G4",
      "allOf": [
        {
          "$ref": "#/$defs/bronze"
        },
        {
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "$ref": "#/$defs/populated"
            }
          },
          "$comment": "G1"
        },
        {
          "required": [
            "review_policy"
          ],
          "properties": {
            "review_policy": {
              "$ref": "#/$defs/populated"
            }
          },
          "$comment": "G2"
        },
        {
          "required": [
            "reviewed_at"
          ],
          "properties": {
            "reviewed_at": {
              "$ref": "#/$defs/populated"
            }
          },
          "$comment": "G3"
        },
        {
          "required": [
            "next_review_at"
          ],
          "properties": {
            "next_review_at": {
              "$ref": "#/$defs/populated"
            }
          },
          "$comment": "G4"
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "author",
        "resource"
      ],
      "properties": {
        "author": {
          "type": "string",
          "pattern": "\\S"
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "$comment": "V2: a URL, a scheme id, or a relative path to a file that exists in the scanned folder. A schema cannot test that the file exists."
        },
        "retrieved_at": {
          "$ref": "#/$defs/isoDate"
        }
      },
      "if": {
        "properties": {
          "resource": {
            "pattern": "^https?://[^\\s]+$"
          }
        }
      },
      "then": {
        "$comment": "V3",
        "required": [
          "retrieved_at"
        ]
      }
    },
    "gold": {
      "title": "Gold: Silver + V1 to V6",
      "allOf": [
        {
          "$ref": "#/$defs/silver"
        },
        {
          "$comment": "V1",
          "required": [
            "ai_involvement"
          ],
          "properties": {
            "ai_involvement": {
              "enum": [
                "none",
                "assisted",
                "generated"
              ]
            }
          }
        },
        {
          "$comment": "V2",
          "required": [
            "sources"
          ],
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        {
          "$comment": "V2: an empty sources list passes only with ai_involvement none",
          "if": {
            "properties": {
              "ai_involvement": {
                "const": "none"
              }
            }
          },
          "else": {
            "properties": {
              "sources": {
                "minItems": 1
              }
            }
          }
        },
        {
          "$comment": "V4",
          "if": {
            "required": [
              "ai_involvement"
            ],
            "properties": {
              "ai_involvement": {
                "enum": [
                  "assisted",
                  "generated"
                ]
              }
            }
          },
          "then": {
            "required": [
              "generated",
              "verified"
            ],
            "properties": {
              "generated": {
                "type": "object",
                "required": [
                  "by",
                  "at"
                ],
                "properties": {
                  "at": {
                    "$ref": "#/$defs/isoDate"
                  }
                }
              },
              "verified": {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "type": "object",
                  "required": [
                    "by",
                    "at"
                  ],
                  "properties": {
                    "by": {
                      "type": "string",
                      "pattern": "^human:[A-Za-z0-9._@-]+$"
                    },
                    "at": {
                      "$ref": "#/$defs/isoDate"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "$comment": "V5: an SPDX id is checked against data/spdx-licenses.json, which a schema cannot read",
          "required": [
            "license"
          ],
          "properties": {
            "license": {
              "type": "string",
              "pattern": "^(proprietary|internal|LicenseRef-[A-Za-z0-9.-]+|[A-Za-z0-9.+-]+)$"
            }
          }
        },
        {
          "$comment": "V6",
          "properties": {
            "generated": {
              "properties": {
                "by": {
                  "type": "string",
                  "pattern": "^(human|process|team):[A-Za-z0-9._@-]+$"
                }
              }
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/bronze"
}
